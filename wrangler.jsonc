{
  "name": "webspace",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "PAGES_BUCKET",
      "bucket_name": "webspace-pages"
    }
  ],
  "observability": {
    "enabled": true
  }
}
